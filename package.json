{
  "name": "am-i-tripping",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A hyper-psychedelic WebGL2 reality-melting experience.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "trip:check": "node tools/trippy-check.mjs",
    "trip:loop": "npm run build && node tools/trippy-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "compression": "^1.7.5"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "playwright": "^1.50.1"
  }
}
